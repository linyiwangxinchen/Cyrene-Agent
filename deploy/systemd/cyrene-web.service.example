[Unit]
Description=Cyrene Agent Web Server
After=network.target

[Service]
Type=simple
User=cyrene
Group=cyrene
WorkingDirectory=/opt/cyrene-agent
Environment=NODE_ENV=production
Environment=CYRENE_WEB_HOST=127.0.0.1
Environment=CYRENE_WEB_PORT=4317
Environment=CYRENE_SECURE_COOKIES=1
Environment=CYRENE_DATA_DIR=/var/lib/cyrene-agent
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/cyrene-agent/.browsers
# Put CYRENE_SETUP_TOKEN in a root-readable EnvironmentFile during first setup.
EnvironmentFile=-/etc/cyrene-agent/server.env
ExecStart=/usr/bin/node /opt/cyrene-agent/dist/server/server/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/cyrene-agent

[Install]
WantedBy=multi-user.target
