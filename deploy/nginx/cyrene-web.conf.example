map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name cyrene.internal.example;

    # Replace with certificates managed by the site administrator.
    ssl_certificate     /etc/letsencrypt/live/cyrene.internal.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyrene.internal.example/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4317;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        client_max_body_size 32m;
    }
}
