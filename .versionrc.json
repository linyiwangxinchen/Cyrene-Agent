{
  "tagPrefix": "v",
  "header": "# 更新日志\n\nCyrene-Agent 的版本变更记录。格式参考 [Keep a Changelog](https://keepachangelog.com/zh-CN/1.1.0/)，\n提交信息遵循 `type(scope): 描述`，版本号遵循[语义化版本](https://semver.org/lang/zh-CN/)。\n\n> 本文件由 `pnpm run release` 生成，请勿手工编辑；需要调整措辞请改写对应的提交信息。\n",
  "types": [
    { "type": "feat", "section": "新增" },
    { "type": "fix", "section": "修复" },
    { "type": "perf", "section": "性能" },
    { "type": "refactor", "section": "重构" },
    { "type": "revert", "section": "回滚" },
    { "type": "build", "section": "构建" },
    { "type": "docs", "section": "文档", "hidden": true },
    { "type": "style", "section": "样式", "hidden": true },
    { "type": "test", "section": "测试", "hidden": true },
    { "type": "ci", "section": "持续集成", "hidden": true },
    { "type": "chore", "section": "杂项", "hidden": true }
  ],
  "preMajor": true,
  "releaseCommitMessageFormat": "chore(版本号): 更新至 {{currentTag}}",
  "bumpFiles": ["package.json"],
  "packageFiles": ["package.json"],
  "commitUrlFormat": "https://github.com/Playa-Cyrene/Cyrene-Agent/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/Playa-Cyrene/Cyrene-Agent/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://github.com/Playa-Cyrene/Cyrene-Agent/issues/{{id}}",
  "userUrlFormat": "https://github.com/{{user}}"
}
